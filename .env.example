# Base de la API del backend NestJS.
#
# Vacío (recomendado en desarrollo y en producción con reverse proxy):
# las peticiones van a rutas relativas /api y /media. Vite las proxya a
# http://localhost:3100 en desarrollo; el hosting las debe enrutar al backend
# en producción. La cookie de sesión viaja same-origin.
VITE_API_URL=

# Alternativa solo si el frontend y la API viven en dominios distintos:
# VITE_API_URL=https://api.bygrow.com.co
#
# En ese caso el backend debe permitir CORS con credenciales para el origen
# exacto del frontend y la cookie debe usar SameSite=None; Secure.
# Recuerda ajustar connect-src, img-src y media-src en la CSP de public/_headers.
#
# Todo lo que empieza por VITE_ es público. Nunca pongas secretos aquí.
